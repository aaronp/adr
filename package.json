{
  "name": "@pritzlaff/adr",
  "version": "1.1.1",
  "description": "Architecture decision records driven by a single markdown file. Builds to one standalone HTML page.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronp/adr.git"
  },
  "homepage": "https://aaronp.github.io/adr/",
  "type": "module",
  "bin": {
    "adr": "bin/adr.mjs"
  },
  "files": [
    "bin",
    "dist/decision-ledger.html",
    "dist/card.mjs",
    "spec.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.2",
    "preact": "^10.29.8",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
